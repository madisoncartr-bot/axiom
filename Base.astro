---
import '../styles/global.css';
const { title = 'AXIOM.OS', description = 'A unified life OS — second brain, learning log, and career arc. Built in the open.' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} — AXIOM.OS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
<div id="app">

  <div class="container">
    <nav class="main-nav">
      <a href="/" class="logo">AXIOM<span>.OS</span></a>
      <ul class="nav-links">
        <li><a href="/brain" class={currentPath.startsWith('/brain') ? 'active' : ''}>Brain</a></li>
        <li><a href="/log" class={currentPath.startsWith('/log') ? 'active' : ''}>Learning Log</a></li>
        <li><a href="/career" class={currentPath.startsWith('/career') ? 'active' : ''}>Career</a></li>
        <li><a href="/now" class={currentPath === '/now' ? 'active' : ''}>Now</a></li>
      </ul>
    </nav>
  </div>

  <slot />

  <footer class="main-footer">
    <div class="container">
      <div class="footer-inner">
        <span class="footer-copy">AXIOM.OS — built in the open</span>
        <span class="footer-copy">All systems go // {new Date().getFullYear()}</span>
      </div>
    </div>
  </footer>

</div>
</body>
</html>
